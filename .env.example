# Cortapis Security Configuration
# Copy this to .env and fill in your values
# NEVER commit .env file to git!

# Flask Environment
FLASK_ENV=development
FLASK_APP=cortapis_security/web_interface.py

# Encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CORTAPIS_ENCRYPTION_KEY=your_fernet_key_here

# Authentication
CORTAPIS_API_KEY_REQUIRED=True
CORTAPIS_API_KEYS=key1,key2,key3

# CORS
CORTAPIS_CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# HTTPS
CORTAPIS_ENFORCE_HTTPS=True

# Logging
CORTAPIS_LOG_LEVEL=INFO
CORTAPIS_LOG_FILE=cortapis.log

# Database (optional, for session persistence)
CORTAPIS_DATABASE_URL=sqlite:///cortapis.db

# Security
CORTAPIS_SESSION_TIMEOUT=3600
CORTAPIS_MAX_TEXT_LENGTH=1000000
